{
  "arena_version": "0.1",
  "agent_name": "TicketTriage Sentinel",
  "domain": "Support-Ticket Triage",
  "description": "Bounded LLM agent that reads sandbox support tickets, classifies priority/category, consults policy snippets, drafts replies and escalates; consequential actions require approval.",
  "endpoint": "/arena/run",
  "health_endpoint": "/health",
  "implementation": "llm-agent",
  "tools": ["list_open_tickets", "get_ticket", "search_kb", "classify_ticket", "draft_reply", "escalate_ticket"],
  "statuses": ["completed", "needs_clarification", "blocked", "approval_required", "tool_error", "contract_error", "budget_exceeded", "failed"],
  "fault_types": ["none", "tool_timeout", "malformed_tool_output", "invalid_agent_decision"],
  "limits": {
    "max_steps": 6,
    "max_tool_retries": 2,
    "run_timeout_seconds": 40,
    "max_response_bytes": 50000
  }
}
