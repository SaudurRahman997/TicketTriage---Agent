HOST=127.0.0.1
PORT=8000
# anthropic | gemini | unconfigured
MODEL_PROVIDER=unconfigured
MODEL_NAME=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Models offered in the UI selector / validated by the API (provider:model, comma separated)
AVAILABLE_MODELS=anthropic:claude-haiku-4-5-20251001,gemini:gemini-2.5-flash
MAX_STEPS=6
HARD_MAX_STEPS=12
MAX_TOOL_RETRIES=2
MAX_OUTPUT_TOKENS=512
RUN_TIMEOUT_SECONDS=40
HISTORY_TURNS=6
HISTORY_CHARS=24000
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_RUNS=4
MAX_DAILY_MODEL_CALLS=1500
